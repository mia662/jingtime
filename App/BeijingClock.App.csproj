<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>disable</ImplicitUsings>
    <AssemblyName>BeijingClock</AssemblyName>
    <RootNamespace>BeijingClock.App</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <Version>1.0.0</Version>
    <Product>北京时间小钟</Product>
    <Description>独立显示北京时间与今日剩余时间的悬浮小钟。</Description>
    <!-- WPF owns startup/DPI; Windows Forms is used only for the tray and screen metadata. -->
    <NoWarn>$(NoWarn);WFAC010</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\Core\BeijingClock.Core.csproj" />
  </ItemGroup>
</Project>
